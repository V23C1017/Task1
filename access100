import os
import sys
from datetime import datetime


def main():
    if len(sys.argv) > 1:
        try:
            count = int(sys.argv[1])
            if count < 0:
                raise ValueError
        except ValueError:
            print("Error: count must be a non-negative integer.", file=sys.stderr)
            sys.exit(1)
    else:
        count = 100

    target = sys.argv[2] if len(sys.argv) > 2 else "/"
    if not os.path.exists(target):
        print(f"Error: path not found: {target}", file=sys.stderr)
        sys.exit(1)

    exclude_dirs = {
        "/proc", "/sys", "/dev", "/run", "/snap", "/mnt",
        "/usr", "/var", "/lib", "/lib64", "/etc", "/boot", "/opt", "/tmp"
    }

    files = []
    for root, dirs, filenames in os.walk(target, topdown=True):
        dirs[:] = [
            d for d in dirs
            if not d.startswith(".") and os.path.join(root, d) not in exclude_dirs
        ]
        for f in filenames:
            if f.startswith("."):
                continue
            filepath = os.path.join(root, f)
            try:
                atime = os.stat(filepath).st_atime
                files.append((atime, filepath))
            except OSError:
                pass

    files.sort(key=lambda x: x[0], reverse=True)

    try:
        for atime, filepath in files[:count]:
            dt = datetime.fromtimestamp(atime).strftime("%Y-%m-%d %H:%M:%S")
            print(f"{dt}  {filepath}")
    except BrokenPipeError:
        sys.stderr.close()
        sys.exit(0)


if __name__ == "__main__":
    main()
